{
  "file_format_version": "1.0.0",
  "layer": {
    "name": "VK_LAYER_FO4HUD_overlay",
    "type": "GLOBAL",
    "library_path": "@LIBRARY_PATH@",
    "api_version": "1.3.0",
    "implementation_version": "1",
    "description": "Fallout 4 ImGui overlay",
    "functions": {
      "vkGetInstanceProcAddr": "fo4hud_vkGetInstanceProcAddr",
      "vkGetDeviceProcAddr": "fo4hud_vkGetDeviceProcAddr"
    },
    "enable_environment": { "FO4HUD_ENABLE": "1" },
    "disable_environment": { "FO4HUD_DISABLE": "1" }
  }
}
